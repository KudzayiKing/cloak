# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/download/
/tool-results/
/scripts/*
!/scripts/
!/scripts/membership-tests.mts
# Regression tests worth keeping (the rest of /scripts is scratch).
!/scripts/verify-pull-to-refresh.mts
!/scripts/verify-multi-account-fix.mjs
!/scripts/verify-reaction-sizing.mts
!/scripts/verify-pwa-update.mts
!/scripts/verify-theme-and-icons.mts
!/scripts/verify-outbox.mts
!/scripts/verify-account-lifecycle.mts
# Operator-overview guard: asserts the metrics module reads no graph table and
# performs no mutation, and that authorization is decided before any aggregate.
!/scripts/verify-admin-overview.mts
# Operator-overview live probe: mints an admin session and a non-admin session
# against the real database, so the 403/401 split and the "no per-account row in
# the payload" property are proven over HTTP rather than by regex.
!/scripts/probe-admin-overview.mjs
# Offline-send (round 40) live regression probes — duplicate-safety over HTTP and
# offline-queue-then-flush-once over a real browser. Worth keeping.
!/scripts/probe-outbox.mjs
!/scripts/probe-outbox-browser.mjs
# Account-erasure live probe (round 41): seeds all four Restrict relations and
# drives the real DELETE route, so the FK ordering is proven against Postgres.
!/scripts/probe-account-lifecycle.mjs
# Account-UI browser probe (round 41). Kept, but it needs a dev harness route
# recreated at src/app/dev-account-harness/page.tsx to run — that route SHIPS
# on Next, so it is never committed.
!/scripts/probe-account-ui.mjs
# The icon generator is the source of truth for the committed brand assets in
# public/icons/, and verify-theme-and-icons.mts asserts on it — so it is source,
# not scratch.
!/scripts/generate-icons-from-logo.py

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/db/*.db
/db/*.db-*
/.zscripts/
/examples/
/mini-services/
/tests/
/upload/
/worklog.md
/Caddyfile
/bun.lock
/scripts/chrome-push-profile/
/scripts/chrome-push-profile2/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
# ROOT-SCOPED on purpose. A bare `local-*` matches a path segment at ANY
# depth, so it silently swallowed src/lib/cloak/local-db.ts and
# src/lib/crypto/local-vault.ts — a commit would have shipped a build with
# unresolvable imports. Keep the leading slash.
/local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# ROOT-SCOPED on purpose. A bare `test`/`prompt` (no leading slash) matches a
# path segment at ANY depth and would silently swallow a nested source file or
# directory of that name — the same class of bug that once swallowed
# local-db.ts / local-vault.ts. Restrict to the repository root.
/test
/prompt

server.log
# Skills directory
/skills/

# assistant working notes (local only, not project source)
/.workbuddy-ai/
