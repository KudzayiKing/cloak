# Supabase pooled connection string for Vercel.
# Example:
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL=""

# Direct connection for Prisma migrations.
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
# If your network cannot reach Supabase direct IPv6, use Session pooler:
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require"
DIRECT_URL=""

# Local/dev-only account seeding. Leave unset in production.
CLOAK_ALLOW_DEV_ACTIVATION=0

# Optional operational logging. Leave unset in production unless debugging.
PRISMA_LOG_QUERIES=0
PRISMA_LOG_ERRORS=0

# Payment verification.
SOLANA_RPC_ENDPOINT=""

# Web Push.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:security@example.com"

# Optional local/model asset URLs. Keep secrets out of NEXT_PUBLIC values.
NEXT_PUBLIC_CLOAK_MODEL_GEMMA_URL=""
NEXT_PUBLIC_CLOAK_MODEL_EMBEDDING_URL=""
NEXT_PUBLIC_CLOAK_MODEL_TRANSLATION_URL=""
